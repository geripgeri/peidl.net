# Build artifact, regenerated by .github/workflows/update-adrs.yaml on every
# run. It is an intermediate between the section measurement and site-stats.json,
# so there is nothing in it worth versioning. It used to be tracked, which meant
# the committed copy was permanently stale because the workflow never added it
# to its commit.
sections.json

# Local tooling only. The renderers that turn the committed svg sources into the
# committed pngs live on one machine and are not part of the site, so the repo
# stays dependency-free static files with no build step.
node_modules/
tools/og-cover.mjs
tools/apple-touch-icon.mjs
